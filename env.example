# 复制为 .env 后按需修改（docker compose 会自动读取）
GITHUB_REPO=EVFBV/blfp-client
INCLUDE_PRERELEASE=true
INCLUDE_DRAFT=false
KEEP_VERSIONS=1
SYNC_INTERVAL_SECONDS=600
SYNC_ON_START=true
DOWNLOAD_CONCURRENCY=2
MAX_RETRIES=3
STALL_TIMEOUT_SECONDS=60

# ── 加速源（镜像）：拉 Release 列表和下载资产时走这些源，避免直连 GitHub 太慢/不通 ──
# auto  = 拉取前现场探测，自动用延迟最低的可用源（默认，推荐）
# fixed = 按下面列表顺序使用，不探测
# off   = 只用直连 GitHub
MIRROR_MODE=auto
# 资产下载加速源（逗号分隔，direct 表示直连；支持 https://x/ 前缀式或 https://x/{url} 模板式）
ASSET_MIRRORS=https://gh-proxy.com/,https://ghfast.top/,https://gh.llkk.cc/,https://ghproxy.net/
# Release API（api.github.com）加速源；能代理 API 的源较少，默认只填一个
API_MIRRORS=https://gh-proxy.com/
# 探测单个源的超时（秒）与探测结果缓存（秒）
# MIRROR_PROBE_TIMEOUT_SECONDS=8
# MIRROR_PROBE_CACHE_SECONDS=1800

# 可选：提升 GitHub API 限额（公开仓库不填也能用）
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# 可选：设置后 POST /api/sync 需要鉴权
# API_TOKEN=change-me

# 可选：下载接口也要求鉴权
PROTECT_DOWNLOADS=false

# 可选：对外地址（反代后填写）
# PUBLIC_BASE_URL=https://dl.example.com

# 可选：只下载匹配该正则的资产，例如只下 exe
# ASSET_REGEX=\.exe$
# ASSET_EXCLUDE_REGEX=\.blockmap$

PORT=8080
LOG_LEVEL=info
